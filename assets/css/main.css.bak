/* ==========================================================================
   TrustNexus Technologies - Enterprise Design System
   Theme: "Engineering blueprint meets intelligent network"
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  /* Core Brand Palette */
  --navy: #0B2545;
  --navy-dark: #061528;
  --navy-deep: #081B33;
  --navy-light: #133E72;
  --cyan: #18C5E0;
  --cyan-bright: #38D4EC;
  --cyan-deep: #0EA5BE;
  --cyan-glow: rgba(24, 197, 224, 0.28);
  --cyan-subtle: rgba(24, 197, 224, 0.08);
  --cloud: #F5F8FC;
  --cloud-card: #FFFFFF;
  --slate: #5B6B7F;
  --slate-light: #8E9FAA;
  --slate-dark: #3A4756;
  --alert-red: #D7263D;
  --alert-red-glow: rgba(215, 38, 61, 0.3);
  --success-green: #10B981;
  --success-glow: rgba(16, 185, 129, 0.2);

  /* Borders & Dividers */
  --border-light: rgba(11, 37, 69, 0.12);
  --border-dark: rgba(24, 197, 224, 0.22);
  --border-cyan: rgba(24, 197, 224, 0.45);
  
  /* Typography */
  --font-heading: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

  /* Elevations */
  --shadow-sm: 0 2px 6px rgba(11, 37, 69, 0.05);
  --shadow-md: 0 8px 24px rgba(11, 37, 69, 0.08);
  --shadow-lg: 0 16px 40px rgba(11, 37, 69, 0.12);
  --shadow-glow: 0 0 28px rgba(24, 197, 224, 0.32);
  --shadow-red-glow: 0 0 28px rgba(215, 38, 61, 0.35);

  /* Transitions */
  --transition-fast: 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-normal: 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-slow: 0.5s cubic-bezier(0.16, 1, 0.3, 1);

  /* Layout */
  --max-width: 1280px;
  --header-height: 80px;
  --header-height-condensed: 64px;
}

/* Reset & Box Sizing */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  scroll-behavior: smooth;
  -webkit-text-size-adjust: 100%;
}

body {
  font-family: var(--font-body);
  color: var(--navy);
  background-color: var(--cloud);
  line-height: 1.6;
  overflow-x: hidden;
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Blueprint Grid Background Pattern */
.blueprint-bg {
  background-color: var(--cloud);
  background-image: 
    linear-gradient(to right, rgba(11, 37, 69, 0.04) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(11, 37, 69, 0.04) 1px, transparent 1px);
  background-size: 36px 36px;
}

.blueprint-grid-dark {
  background-color: var(--navy);
  background-image: 
    linear-gradient(to right, rgba(24, 197, 224, 0.06) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(24, 197, 224, 0.06) 1px, transparent 1px);
  background-size: 36px 36px;
  color: #FFFFFF;
}

/* Skip link for Accessibility */
.skip-link {
  position: absolute;
  top: -60px;
  left: 20px;
  background: var(--navy);
  color: var(--cyan);
  padding: 10px 16px;
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 600;
  z-index: 9999;
  border: 1px solid var(--cyan);
  transition: top var(--transition-fast);
}

.skip-link:focus {
  top: 16px;
}

/* Typography Hierarchy */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 700;
  line-height: 1.18;
  letter-spacing: -0.02em;
  color: inherit;
}

h1 {
  font-size: clamp(2.25rem, 5vw, 3.75rem);
}

h2 {
  font-size: clamp(1.75rem, 3.5vw, 2.65rem);
}

h3 {
  font-size: clamp(1.25rem, 2.5vw, 1.65rem);
}

h4 {
  font-size: 1.2rem;
  font-weight: 600;
}

p {
  color: var(--slate);
  font-size: 1.025rem;
  line-height: 1.65;
}

.blueprint-grid-dark p,
.dark-section p {
  color: #B2C4D6;
}

a {
  color: var(--navy);
  text-decoration: none;
  transition: color var(--transition-fast);
}

a:hover, a:focus-visible {
  color: var(--cyan-deep);
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Monospace Badges & Technical Indicators */
.tech-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 12px;
  background: rgba(11, 37, 69, 0.05);
  border: 1px solid var(--border-light);
  border-left: 3px solid var(--cyan);
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--navy);
  border-radius: 2px;
  font-weight: 600;
}

.dark-section .tech-badge,
.blueprint-grid-dark .tech-badge {
  background: rgba(24, 197, 224, 0.1);
  border-color: rgba(24, 197, 224, 0.25);
  border-left-color: var(--cyan);
  color: var(--cyan-bright);
}

.tech-badge.alert {
  border-left-color: var(--alert-red);
  color: var(--alert-red);
  background: rgba(215, 38, 61, 0.08);
}

/* Confirm Placeholder Badge */
.confirm-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: #FFF9DB;
  border: 1px dashed #F59F00;
  color: #8F5B00;
  padding: 2px 8px;
  border-radius: 3px;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  margin: 0 2px;
}

.dark-section .confirm-badge {
  background: rgba(245, 159, 0, 0.15);
  border-color: #F59F00;
  color: #FFD43B;
}

/* Container */
.container {
  width: 100%;
  max-width: var(--max-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: 24px;
  padding-right: 24px;
}

/* Section Spacing */
.section-padding {
  padding-top: clamp(60px, 8vw, 100px);
  padding-bottom: clamp(60px, 8vw, 100px);
}

.section-padding-sm {
  padding-top: clamp(40px, 5vw, 60px);
  padding-bottom: clamp(40px, 5vw, 60px);
}

/* ==========================================================================
   Header & Navigation
   ========================================================================== */
.site-header {
  position: sticky;
  top: 0;
  left: 0;
  width: 100%;
  height: var(--header-height);
  background: rgba(245, 248, 252, 0.94);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border-light);
  z-index: 1000;
  transition: height var(--transition-normal), background-color var(--transition-normal), box-shadow var(--transition-normal);
}

.site-header.is-condensed {
  height: var(--header-height-condensed);
  background: rgba(245, 248, 252, 0.98);
  box-shadow: 0 4px 20px rgba(11, 37, 69, 0.08);
  border-bottom-color: rgba(24, 197, 224, 0.3);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}

.brand-link {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
}

.brand-logo-img {
  height: 48px;
  width: auto;
  object-fit: contain;
  transition: transform var(--transition-fast);
}

.site-header.is-condensed .brand-logo-img {
  height: 40px;
}

.brand-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1.25rem;
  color: var(--navy);
  letter-spacing: -0.01em;
  line-height: 1.1;
}

.brand-name span {
  color: var(--cyan-deep);
}

.brand-sub {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--slate);
}

/* Nav Menu */
.main-nav {
  display: none;
}

@media (min-width: 1024px) {
  .main-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
}

.nav-list {
  display: flex;
  align-items: center;
  list-style: none;
  gap: 22px;
}

.nav-item {
  position: relative;
}

.nav-link {
  font-family: var(--font-body);
  font-weight: 500;
  font-size: 0.95rem;
  color: var(--navy);
  padding: 8px 4px;
  position: relative;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: color var(--transition-fast);
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 2px;
  background: var(--cyan);
  transition: width var(--transition-normal);
}

.nav-link:hover::after,
.nav-link.active::after {
  width: 100%;
}

.nav-link.active {
  color: var(--cyan-deep);
  font-weight: 600;
}

/* Dropdown */
.dropdown-chevron {
  width: 14px;
  height: 14px;
  stroke: currentColor;
  stroke-width: 2;
  transition: transform var(--transition-fast);
}

.has-dropdown:hover .dropdown-chevron,
.has-dropdown:focus-within .dropdown-chevron {
  transform: rotate(180deg);
}

.dropdown-menu {
  position: absolute;
  top: 100%;
  left: -20px;
  width: 320px;
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-top: 2px solid var(--cyan);
  box-shadow: 0 16px 36px rgba(11, 37, 69, 0.12);
  border-radius: 4px;
  padding: 12px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(8px);
  transition: all var(--transition-normal);
  display: flex;
  flex-direction: column;
  gap: 6px;
  z-index: 1001;
}

.has-dropdown:hover .dropdown-menu,
.has-dropdown:focus-within .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.dropdown-link {
  display: flex;
  flex-direction: column;
  padding: 10px 12px;
  border-radius: 4px;
  text-decoration: none;
  transition: background-color var(--transition-fast);
  border: 1px solid transparent;
}

.dropdown-link:hover,
.dropdown-link:focus-visible {
  background: rgba(24, 197, 224, 0.08);
  border-color: rgba(24, 197, 224, 0.25);
}

.dropdown-title {
  font-family: var(--font-heading);
  font-size: 0.92rem;
  font-weight: 600;
  color: var(--navy);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dropdown-desc {
  font-size: 0.76rem;
  color: var(--slate);
  margin-top: 2px;
  line-height: 1.35;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 24px;
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.95rem;
  border-radius: 3px;
  cursor: pointer;
  transition: all var(--transition-fast);
  border: 1px solid transparent;
  position: relative;
  text-decoration: none;
  line-height: 1;
}

.btn-primary {
  background: var(--navy);
  color: #FFFFFF;
  border-color: var(--navy);
  box-shadow: 0 4px 14px rgba(11, 37, 69, 0.2);
}

.btn-primary:hover,
.btn-primary:focus-visible {
  background: var(--cyan);
  color: var(--navy);
  border-color: var(--cyan);
  box-shadow: var(--shadow-glow);
  transform: translateY(-2px);
}

.btn-cyan {
  background: var(--cyan);
  color: var(--navy);
  border-color: var(--cyan);
  font-weight: 700;
}

.btn-cyan:hover,
.btn-cyan:focus-visible {
  background: var(--cyan-bright);
  box-shadow: var(--shadow-glow);
  transform: translateY(-2px);
}

.btn-outline {
  background: transparent;
  color: var(--navy);
  border-color: var(--navy);
}

.btn-outline:hover,
.btn-outline:focus-visible {
  background: var(--navy);
  color: #FFFFFF;
  transform: translateY(-2px);
}

.btn-outline-cyan {
  background: transparent;
  color: var(--cyan);
  border-color: var(--cyan);
}

.btn-outline-cyan:hover,
.btn-outline-cyan:focus-visible {
  background: var(--cyan);
  color: var(--navy);
  box-shadow: var(--shadow-glow);
}

.btn-sm {
  padding: 8px 16px;
  font-size: 0.85rem;
}

.btn-lg {
  padding: 16px 32px;
  font-size: 1.05rem;
}

/* Mobile Menu Button */
.mobile-menu-btn {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 44px;
  height: 44px;
  background: transparent;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  cursor: pointer;
  padding: 10px;
}

@media (min-width: 1024px) {
  .mobile-menu-btn {
    display: none;
  }
}

.mobile-menu-btn span {
  display: block;
  width: 100%;
  height: 2px;
  background: var(--navy);
  transition: all var(--transition-fast);
}

.mobile-menu-btn[aria-expanded="true"] span:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.mobile-menu-btn[aria-expanded="true"] span:nth-child(2) {
  opacity: 0;
}

.mobile-menu-btn[aria-expanded="true"] span:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

/* Mobile Drawer */
.mobile-drawer {
  position: fixed;
  top: var(--header-height);
  left: 0;
  width: 100%;
  height: calc(100vh - var(--header-height));
  background: #FFFFFF;
  z-index: 999;
  overflow-y: auto;
  padding: 24px;
  transform: translateX(100%);
  transition: transform var(--transition-normal);
  border-top: 1px solid var(--border-light);
}

.mobile-drawer.is-open {
  transform: translateX(0);
}

.mobile-nav-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mobile-nav-link {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--navy);
  display: block;
  padding: 8px 0;
  border-bottom: 1px solid var(--border-light);
}

.mobile-dropdown-header {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--navy);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
}

.mobile-sub-list {
  list-style: none;
  padding-left: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 8px;
  margin-bottom: 12px;
}

.mobile-sub-link {
  font-size: 0.95rem;
  color: var(--slate);
  display: block;
  padding: 4px 0;
}

/* ==========================================================================
   Engineering Blueprint Cards & Corner Brackets
   ========================================================================== */
.blueprint-card {
  position: relative;
  background: var(--cloud-card);
  border: 1px solid var(--border-light);
  padding: 32px;
  border-radius: 2px;
  transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
}

.blueprint-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-cyan);
  box-shadow: var(--shadow-md), 0 0 20px rgba(24, 197, 224, 0.15);
}

.corner-brackets {
  position: relative;
}

.corner-brackets::before,
.corner-brackets::after {
  content: '';
  position: absolute;
  width: 10px;
  height: 10px;
  pointer-events: none;
  border-color: var(--cyan);
  transition: width var(--transition-fast), height var(--transition-fast);
}

.corner-brackets::before {
  top: -1px;
  left: -1px;
  border-top: 2px solid;
  border-left: 2px solid;
}

.corner-brackets::after {
  bottom: -1px;
  right: -1px;
  border-bottom: 2px solid;
  border-right: 2px solid;
}

.blueprint-card:hover.corner-brackets::before,
.blueprint-card:hover.corner-brackets::after {
  width: 16px;
  height: 16px;
  border-color: var(--cyan-bright);
}

.dark-section .blueprint-card {
  background: rgba(14, 38, 70, 0.75);
  border-color: rgba(24, 197, 224, 0.2);
  backdrop-filter: blur(8px);
  color: #FFFFFF;
}

.dark-section .blueprint-card:hover {
  border-color: var(--cyan);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35), var(--shadow-glow);
}

.step-number {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--cyan);
  letter-spacing: 0.08em;
  margin-bottom: 8px;
  display: block;
}

/* ==========================================================================
   Three Pillars Strip Under Hero
   ========================================================================== */
.three-pillars-strip {
  background: #FFFFFF;
  border-top: 1px solid var(--border-light);
  border-bottom: 1px solid var(--border-light);
  padding: 32px 0;
  box-shadow: var(--shadow-sm);
}

.three-pillars-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}

@media (min-width: 768px) {
  .three-pillars-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
}

.pillar-item {
  display: flex;
  flex-direction: column;
  padding: 8px 12px;
  border-left: 3px solid var(--cyan);
}

.pillar-title {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.pillar-desc {
  font-size: 0.9rem;
  color: var(--slate);
  line-height: 1.5;
  margin: 0;
}

/* ==========================================================================
   Quote Highlight Banner
   ========================================================================== */
.quote-highlight-banner {
  background: var(--navy);
  color: #FFFFFF;
  padding: clamp(40px, 5vw, 60px) 0;
  border-left: 6px solid var(--cyan);
  margin: 40px 0;
}

.quote-text {
  font-family: var(--font-heading);
  font-size: clamp(1.2rem, 2.4vw, 1.65rem);
  font-weight: 600;
  line-height: 1.45;
  color: #FFFFFF;
  max-width: 900px;
}

.quote-author {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--cyan-bright);
  margin-top: 14px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

/* ==========================================================================
   Client Logo Wall & Sector Tabs
   ========================================================================== */
.logo-wall-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
  margin-top: 28px;
}

@media (min-width: 640px) {
  .logo-wall-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1024px) {
  .logo-wall-grid {
    grid-template-columns: repeat(6, 1fr);
  }
}

.client-logo-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 3px;
  padding: 20px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 90px;
  transition: all var(--transition-fast);
}

.client-logo-card:hover {
  border-color: var(--cyan);
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

.client-logo-name {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 0.95rem;
  color: var(--navy);
}

.client-logo-sector {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--slate);
  margin-top: 4px;
  text-transform: uppercase;
}

/* ==========================================================================
   Approach Timeline (Survey -> Design -> Integrate -> Commission -> Support)
   ========================================================================== */
.timeline-strip {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  margin-top: 40px;
}

@media (min-width: 768px) {
  .timeline-strip {
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
}

.timeline-step {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-top: 3px solid var(--cyan);
  padding: 20px;
  border-radius: 2px;
  position: relative;
}

.timeline-step-num {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--cyan-deep);
  margin-bottom: 4px;
}

.timeline-step-title {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 6px;
}

.timeline-step-desc {
  font-size: 0.82rem;
  color: var(--slate);
  line-height: 1.45;
}

/* ==========================================================================
   Home Hero Section
   ========================================================================== */
.hero-section {
  position: relative;
  overflow: hidden;
  padding-top: clamp(40px, 6vw, 80px);
  padding-bottom: clamp(60px, 8vw, 100px);
  border-bottom: 1px solid var(--border-light);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
  align-items: center;
}

@media (min-width: 1024px) {
  .hero-grid {
    grid-template-columns: 1.1fr 1fr;
    gap: 60px;
  }
}

.hero-title {
  margin-top: 16px;
  margin-bottom: 20px;
}

.hero-title .gradient-text {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 60%, var(--cyan-deep) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero-lead {
  font-size: 1.18rem;
  color: var(--slate);
  margin-bottom: 32px;
  max-width: 600px;
  line-height: 1.6;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  align-items: center;
}

.hero-visual-card {
  position: relative;
  background: #081B33;
  border: 1px solid rgba(24, 197, 224, 0.3);
  border-radius: 4px;
  padding: 20px;
  box-shadow: 0 20px 50px rgba(11, 37, 69, 0.25);
  color: #FFFFFF;
}

.hero-visual-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(24, 197, 224, 0.2);
  padding-bottom: 12px;
  margin-bottom: 16px;
}

.terminal-dots {
  display: flex;
  gap: 6px;
}

.terminal-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.terminal-dot.cyan {
  background: var(--cyan);
  box-shadow: 0 0 8px var(--cyan);
}

.terminal-title {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--cyan);
  letter-spacing: 0.05em;
}

.state-toggle-btn {
  background: rgba(24, 197, 224, 0.15);
  border: 1px solid var(--cyan);
  color: var(--cyan-bright);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  padding: 4px 10px;
  border-radius: 2px;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.state-toggle-btn:hover {
  background: var(--cyan);
  color: var(--navy);
}

.isometric-stage-wrapper {
  position: relative;
  width: 100%;
  height: 380px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.isometric-building-svg {
  width: 100%;
  height: 100%;
  max-width: 500px;
}

.building-wireframe {
  stroke: rgba(255, 255, 255, 0.25);
  stroke-width: 1.2;
  fill: rgba(14, 38, 70, 0.6);
  transition: all 0.6s ease;
}

.building-wireframe.active-nerve {
  stroke: var(--cyan);
  fill: rgba(24, 197, 224, 0.12);
  filter: drop-shadow(0 0 8px rgba(24, 197, 224, 0.4));
}

.data-node-pulse {
  animation: pulse-node 2.2s infinite ease-in-out;
  transform-origin: center;
}

@keyframes pulse-node {
  0% { r: 3; opacity: 0.4; }
  50% { r: 6; opacity: 1; filter: drop-shadow(0 0 6px var(--cyan)); }
  100% { r: 3; opacity: 0.4; }
}

.data-line-flow {
  stroke-dasharray: 6 6;
  animation: flow-dash 2s linear infinite;
}

@keyframes flow-dash {
  to { stroke-dashoffset: -24; }
}

.hud-telemetry-badge {
  position: absolute;
  bottom: 12px;
  left: 12px;
  right: 12px;
  background: rgba(6, 21, 40, 0.85);
  border: 1px solid rgba(24, 197, 224, 0.3);
  padding: 8px 12px;
  border-radius: 2px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: #B2C4D6;
}

.hud-telemetry-badge span.live-status {
  color: var(--success-green);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.hud-telemetry-badge span.live-status::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--success-green);
  box-shadow: 0 0 6px var(--success-green);
}

/* ==========================================================================
   Interactive Exploded 4-Layer Building (Overview Page)
   ========================================================================== */
.exploded-view-container {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  align-items: center;
  margin-top: 40px;
}

@media (min-width: 1024px) {
  .exploded-view-container {
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
  }
}

.exploded-layers-svg {
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  cursor: pointer;
}

.building-slice {
  cursor: pointer;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
}

.building-slice:hover,
.building-slice.active-slice {
  transform: translateY(-8px);
}

.slice-polygon {
  fill: #0F315B;
  stroke: rgba(24, 197, 224, 0.35);
  stroke-width: 1.5;
  transition: all 0.3s ease;
}

.building-slice:hover .slice-polygon,
.building-slice.active-slice .slice-polygon {
  fill: #133E72;
  stroke: var(--cyan);
  filter: drop-shadow(0 0 12px rgba(24, 197, 224, 0.5));
}

.layer-selector-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.layer-select-btn {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 18px 20px;
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-left: 4px solid #CBD5E1;
  border-radius: 3px;
  cursor: pointer;
  text-align: left;
  transition: all var(--transition-fast);
}

.layer-select-btn:hover {
  border-color: var(--border-cyan);
  transform: translateX(4px);
}

.layer-select-btn.active {
  border-left-color: var(--cyan);
  border-color: var(--cyan);
  background: rgba(24, 197, 224, 0.05);
  box-shadow: 0 6px 18px rgba(24, 197, 224, 0.12);
}

.layer-num {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--slate);
}

.layer-select-btn.active .layer-num {
  color: var(--cyan-deep);
}

.layer-title {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 4px;
}

.layer-summary {
  font-size: 0.86rem;
  color: var(--slate);
  line-height: 1.45;
}

.layer-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}

.layer-subsystem-tag {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  background: rgba(11, 37, 69, 0.06);
  color: var(--navy);
  padding: 2px 8px;
  border-radius: 2px;
}

.layer-select-btn.active .layer-subsystem-tag {
  background: rgba(24, 197, 224, 0.15);
  color: var(--navy);
}

/* ==========================================================================
   Systems Orchestration - Emergency Simulation Engine
   ========================================================================== */
.simulation-cabinet {
  background: #081B33;
  border: 1px solid rgba(24, 197, 224, 0.35);
  border-radius: 4px;
  padding: clamp(24px, 4vw, 40px);
  color: #FFFFFF;
  box-shadow: 0 16px 50px rgba(11, 37, 69, 0.4);
}

.simulation-control-header {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 20px;
  border-bottom: 1px solid rgba(24, 197, 224, 0.2);
  margin-bottom: 28px;
}

.sim-hud-status {
  display: flex;
  align-items: center;
  gap: 12px;
}

.status-indicator-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--success-green);
  box-shadow: 0 0 10px var(--success-green);
  transition: all 0.3s ease;
}

.status-indicator-dot.emergency-active {
  background: var(--alert-red);
  box-shadow: 0 0 16px var(--alert-red);
  animation: blink-alarm 0.8s infinite alternate;
}

@keyframes blink-alarm {
  0% { opacity: 0.3; }
  100% { opacity: 1; }
}

.sim-status-title {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  font-weight: 700;
}

.sim-status-desc {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: #8E9FAA;
}

.sim-controls-group {
  display: flex;
  gap: 12px;
}

.sim-flow-arena {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  position: relative;
}

@media (min-width: 900px) {
  .sim-flow-arena {
    grid-template-columns: 1fr 1.6fr;
    gap: 36px;
  }
}

.trigger-sensor-card {
  background: rgba(14, 38, 70, 0.6);
  border: 1px solid rgba(24, 197, 224, 0.25);
  padding: 24px;
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  transition: all 0.35s ease;
}

.trigger-sensor-card.tripped {
  border-color: var(--alert-red);
  background: rgba(215, 38, 61, 0.12);
  box-shadow: 0 0 30px rgba(215, 38, 61, 0.35);
}

.sensor-optic-icon {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(24, 197, 224, 0.1);
  border: 2px solid var(--cyan);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  transition: all 0.3s ease;
}

.trigger-sensor-card.tripped .sensor-optic-icon {
  border-color: var(--alert-red);
  background: rgba(215, 38, 61, 0.2);
  color: var(--alert-red);
}

.orchestration-actions-stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.orchestration-action-node {
  background: rgba(11, 37, 69, 0.6);
  border: 1px solid rgba(24, 197, 224, 0.2);
  padding: 16px 20px;
  border-radius: 3px;
  display: flex;
  align-items: flex-start;
  gap: 16px;
  opacity: 0.45;
  transform: translateX(0);
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.orchestration-action-node.firing {
  opacity: 1;
  transform: translateX(8px);
  border-color: var(--cyan);
  background: rgba(24, 197, 224, 0.12);
  box-shadow: 0 4px 20px rgba(24, 197, 224, 0.2);
}

.action-node-icon {
  width: 40px;
  height: 40px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--cyan);
}

.orchestration-action-node.firing .action-node-icon {
  background: var(--cyan);
  color: var(--navy);
}

.action-node-content h5 {
  font-family: var(--font-heading);
  font-size: 1rem;
  color: #FFFFFF;
  margin-bottom: 2px;
}

.action-node-content p {
  font-size: 0.82rem;
  color: #B2C4D6;
  margin: 0;
  line-height: 1.4;
}

.action-latency-stamp {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--cyan-bright);
  margin-top: 4px;
  display: block;
}

.sim-event-terminal {
  margin-top: 28px;
  background: #040D1A;
  border: 1px solid rgba(24, 197, 224, 0.2);
  border-radius: 3px;
  padding: 16px;
  font-family: var(--font-mono);
  font-size: 0.78rem;
  max-height: 160px;
  overflow-y: auto;
}

.event-log-entry {
  display: flex;
  gap: 12px;
  padding: 3px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.05);
}

.event-timestamp {
  color: var(--slate-light);
}

.event-type-alert {
  color: var(--alert-red);
  font-weight: 700;
}

.event-type-action {
  color: var(--cyan-bright);
}

.event-type-system {
  color: var(--success-green);
}

/* ==========================================================================
   Access Control 3-Step Flow & Red Override
   ========================================================================== */
.access-control-flow-wrapper {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  padding: clamp(24px, 4vw, 40px);
  position: relative;
  box-shadow: var(--shadow-sm);
  margin-top: 36px;
}

.access-flow-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  position: relative;
}

@media (min-width: 768px) {
  .access-flow-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
}

.flow-step-card {
  background: var(--cloud);
  border: 1px solid var(--border-light);
  padding: 24px;
  border-radius: 3px;
  position: relative;
  text-align: center;
}

.flow-step-icon {
  width: 56px;
  height: 56px;
  margin: 0 auto 16px;
  background: #FFFFFF;
  border: 1px solid var(--border-cyan);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cyan-deep);
}

.override-bypass-conduit {
  margin-top: 36px;
  padding: 20px;
  background: rgba(215, 38, 61, 0.04);
  border: 2px dashed var(--alert-red);
  border-radius: 4px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
}

@media (min-width: 768px) {
  .override-bypass-conduit {
    flex-direction: row;
  }
}

.override-info {
  display: flex;
  align-items: center;
  gap: 16px;
}

.override-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(215, 38, 61, 0.15);
  color: var(--alert-red);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.btn-trigger-override {
  background: var(--alert-red);
  color: #FFFFFF;
  border: none;
  padding: 10px 20px;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  font-weight: 700;
  border-radius: 3px;
  cursor: pointer;
  letter-spacing: 0.05em;
  transition: all var(--transition-fast);
}

.btn-trigger-override:hover {
  background: #b51a2d;
  box-shadow: var(--shadow-red-glow);
}

/* ==========================================================================
   AMC 2.0 Interactive Infinity Loop / Node Hub
   ========================================================================== */
.infinity-hub-container {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  align-items: center;
  margin-top: 40px;
}

@media (min-width: 1024px) {
  .infinity-hub-container {
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }
}

.infinity-svg-holder {
  position: relative;
  width: 100%;
  max-width: 480px;
  margin: 0 auto;
}

.amc-loop-node {
  cursor: pointer;
  transition: all 0.3s ease;
}

.amc-loop-node circle {
  transition: all 0.3s ease;
}

.amc-loop-node:hover circle,
.amc-loop-node.active circle {
  fill: var(--cyan);
  filter: drop-shadow(0 0 10px var(--cyan));
}

.amc-detail-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-left: 4px solid var(--cyan);
  padding: 32px;
  border-radius: 3px;
  box-shadow: var(--shadow-md);
}

.amc-feature-item {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-top: 14px;
}

.amc-feature-item svg {
  color: var(--cyan-deep);
  flex-shrink: 0;
  margin-top: 2px;
}

/* ==========================================================================
   Solutions Common Layout Modules
   ========================================================================== */
.solution-hero-banner {
  background: var(--navy);
  color: #FFFFFF;
  padding: clamp(60px, 8vw, 100px) 0;
  position: relative;
  border-bottom: 2px solid var(--cyan);
}

.solution-hero-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 36px;
  align-items: center;
}

@media (min-width: 1024px) {
  .solution-hero-grid {
    grid-template-columns: 1.2fr 0.8fr;
    gap: 48px;
  }
}

.solution-hero-img-box {
  position: relative;
  border-radius: 4px;
  overflow: hidden;
  border: 1px solid rgba(24, 197, 224, 0.4);
  box-shadow: var(--shadow-lg), 0 0 30px rgba(24, 197, 224, 0.2);
}

.solution-hero-img-box img {
  width: 100%;
  height: 380px;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.solution-hero-img-box:hover img {
  transform: scale(1.04);
}

.capabilities-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
  margin-top: 40px;
}

@media (min-width: 640px) {
  .capabilities-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .capabilities-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.integration-strip {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  padding: 32px;
  margin-top: 48px;
}

.integration-protocol-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 16px;
}

.protocol-tag {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  background: rgba(11, 37, 69, 0.05);
  border: 1px solid var(--border-light);
  padding: 6px 14px;
  border-radius: 2px;
  color: var(--navy);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8px;
}

.protocol-tag::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--cyan);
}

.outcomes-metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-top: 40px;
}

@media (min-width: 1024px) {
  .outcomes-metric-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.outcome-stat-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-top: 3px solid var(--cyan);
  padding: 24px;
  border-radius: 2px;
  text-align: center;
}

.outcome-stat-val {
  font-family: var(--font-heading);
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--navy);
  line-height: 1.1;
}

.outcome-stat-lbl {
  font-size: 0.86rem;
  color: var(--slate);
  margin-top: 8px;
  line-height: 1.4;
}

.oem-brand-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin-top: 28px;
}

.oem-brand-badge {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  padding: 10px 20px;
  font-family: var(--font-heading);
  font-weight: 700;
  color: var(--slate-dark);
  border-radius: 3px;
  font-size: 0.92rem;
  letter-spacing: 0.02em;
  transition: all var(--transition-fast);
}

.oem-brand-badge:hover {
  border-color: var(--cyan);
  color: var(--navy);
  transform: translateY(-2px);
  box-shadow: var(--shadow-sm);
}

.cta-band {
  background: var(--navy);
  color: #FFFFFF;
  padding: clamp(60px, 7vw, 90px) 0;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.cta-band .container {
  position: relative;
  z-index: 2;
}

.cta-band h2 {
  color: #FFFFFF;
  margin-bottom: 16px;
}

.cta-band p {
  color: #B2C4D6;
  max-width: 640px;
  margin: 0 auto 32px;
  font-size: 1.12rem;
}

/* ==========================================================================
   Comparison Table (Why Us)
   ========================================================================== */
.comparison-table-wrapper {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  overflow-x: auto;
  box-shadow: var(--shadow-sm);
  margin-top: 40px;
}

.comparison-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 700px;
}

.comparison-table th,
.comparison-table td {
  padding: 18px 24px;
  text-align: left;
  border-bottom: 1px solid var(--border-light);
}

.comparison-table th {
  font-family: var(--font-heading);
  font-size: 1rem;
  background: var(--cloud);
  color: var(--navy);
}

.comparison-table th.trustnexus-col {
  background: var(--navy);
  color: #FFFFFF;
  border-top: 3px solid var(--cyan);
}

.comparison-table td.trustnexus-col {
  background: rgba(24, 197, 224, 0.03);
  font-weight: 600;
  color: var(--navy);
}

.feature-tag-box {
  color: var(--alert-red);
}

.feature-tag-tn {
  color: var(--success-green);
  display: flex;
  align-items: center;
  gap: 8px;
}

/* ==========================================================================
   Track Record Case Studies & Sector Cards
   ========================================================================== */
.case-study-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  overflow: hidden;
  display: grid;
  grid-template-columns: 1fr;
  box-shadow: var(--shadow-sm);
  margin-bottom: 32px;
  transition: all var(--transition-normal);
}

@media (min-width: 1024px) {
  .case-study-card {
    grid-template-columns: 1fr 1.3fr;
  }
}

.case-study-card:hover {
  transform: translateY(-4px);
  border-color: var(--border-cyan);
  box-shadow: var(--shadow-md);
}

.case-study-img-holder {
  position: relative;
  min-height: 280px;
}

.case-study-img-holder img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.case-study-content {
  padding: 36px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.case-metrics-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid var(--border-light);
}

.case-metric-item h4 {
  font-family: var(--font-heading);
  font-size: 1.3rem;
  color: var(--navy);
}

.case-metric-item span {
  font-size: 0.75rem;
  color: var(--slate);
  font-family: var(--font-mono);
}

/* ==========================================================================
   Contact Page & Form
   ========================================================================== */
.contact-layout-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 48px;
}

@media (min-width: 1024px) {
  .contact-layout-grid {
    grid-template-columns: 1.2fr 0.8fr;
  }
}

.survey-form-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  padding: clamp(28px, 4vw, 44px);
  border-radius: 4px;
  box-shadow: var(--shadow-md);
  position: relative;
}

.form-grid-row {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

@media (min-width: 640px) {
  .form-grid-row.two-col {
    grid-template-columns: 1fr 1fr;
  }
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.form-label {
  font-family: var(--font-body);
  font-weight: 600;
  font-size: 0.88rem;
  color: var(--navy);
}

.form-label span.req {
  color: var(--alert-red);
}

.form-input,
.form-select,
.form-textarea {
  width: 100%;
  padding: 12px 14px;
  font-family: var(--font-body);
  font-size: 0.95rem;
  color: var(--navy);
  background: var(--cloud);
  border: 1px solid var(--border-light);
  border-radius: 3px;
  transition: all var(--transition-fast);
}

.form-input:focus,
.form-select:focus,
.form-textarea:focus {
  outline: none;
  border-color: var(--cyan);
  background: #FFFFFF;
  box-shadow: 0 0 0 3px rgba(24, 197, 224, 0.15);
}

.form-input.is-invalid,
.form-select.is-invalid,
.form-textarea.is-invalid {
  border-color: var(--alert-red);
  background: #FFF5F5;
}

.form-error-msg {
  font-size: 0.76rem;
  color: var(--alert-red);
  font-family: var(--font-mono);
  display: none;
}

.form-error-msg.visible {
  display: block;
}

.form-success-container {
  display: none;
  padding: 40px 20px;
  text-align: center;
}

.form-success-container.is-active {
  display: block;
}

.success-check-icon {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.12);
  color: var(--success-green);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 20px;
}

.survey-ref-code {
  display: inline-block;
  background: var(--navy);
  color: var(--cyan-bright);
  font-family: var(--font-mono);
  font-size: 1.1rem;
  font-weight: 700;
  padding: 8px 16px;
  border-radius: 3px;
  letter-spacing: 0.08em;
  margin: 16px 0;
}

.contact-info-panel {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.contact-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  padding: 24px;
  border-radius: 4px;
}

.contact-item {
  display: flex;
  gap: 16px;
  align-items: flex-start;
  margin-bottom: 20px;
}

.contact-item:last-child {
  margin-bottom: 0;
}

.contact-item-icon {
  width: 44px;
  height: 44px;
  border-radius: 4px;
  background: rgba(24, 197, 224, 0.1);
  color: var(--cyan-deep);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.contact-item-text h4 {
  font-size: 0.95rem;
  margin-bottom: 4px;
}

.contact-item-text p,
.contact-item-text a {
  font-size: 0.88rem;
  color: var(--slate);
  margin: 0;
}

.contact-item-text a:hover {
  color: var(--cyan-deep);
}

.quick-channels {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-top: 8px;
}

.channel-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px;
  border-radius: 3px;
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 0.88rem;
  text-decoration: none;
  transition: all var(--transition-fast);
}

.channel-btn.call-btn {
  background: var(--navy);
  color: #FFFFFF;
}

.channel-btn.call-btn:hover {
  background: var(--navy-light);
  color: #FFFFFF;
}

.channel-btn.wa-btn {
  background: #25D366;
  color: #FFFFFF;
}

.channel-btn.wa-btn:hover {
  background: #1EBE5D;
  color: #FFFFFF;
}

.map-embed-wrapper {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  overflow: hidden;
  height: 280px;
  position: relative;
}

.map-embed-wrapper iframe {
  width: 100%;
  height: 100%;
  border: none;
}

/* ==========================================================================
   Footer
   ========================================================================== */
.site-footer {
  background: var(--navy-dark);
  color: #FFFFFF;
  margin-top: auto;
  border-top: 2px solid var(--navy-light);
  position: relative;
}

.footer-top {
  padding: clamp(48px, 6vw, 80px) 0 40px;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
}

@media (min-width: 640px) {
  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .footer-grid {
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 48px;
  }
}

.footer-brand p {
  color: #8E9FAA;
  font-size: 0.9rem;
  margin-top: 14px;
  max-width: 320px;
}

.footer-heading {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 20px;
  letter-spacing: 0.02em;
  position: relative;
  display: inline-block;
}

.footer-heading::after {
  content: '';
  position: absolute;
  bottom: -6px;
  left: 0;
  width: 24px;
  height: 2px;
  background: var(--cyan);
}

.footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-links a {
  color: #8E9FAA;
  font-size: 0.88rem;
  text-decoration: none;
  transition: color var(--transition-fast), transform var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.footer-links a:hover,
.footer-links a:focus-visible {
  color: var(--cyan-bright);
  transform: translateX(3px);
}

.footer-contact-item {
  display: flex;
  gap: 12px;
  margin-bottom: 14px;
  color: #8E9FAA;
  font-size: 0.88rem;
  align-items: flex-start;
}

.footer-contact-item svg {
  color: var(--cyan);
  flex-shrink: 0;
  margin-top: 2px;
}

.footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding: 24px 0;
}

.footer-bottom-inner {
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
  text-align: center;
}

@media (min-width: 768px) {
  .footer-bottom-inner {
    flex-direction: row;
    text-align: left;
  }
}

.footer-copyright {
  font-size: 0.8rem;
  color: #6C7D93;
  font-family: var(--font-mono);
}

.footer-bottom-links {
  display: flex;
  gap: 20px;
}

.footer-bottom-links a {
  font-size: 0.8rem;
  color: #8E9FAA;
}

.footer-bottom-links a:hover {
  color: var(--cyan);
}

/* ==========================================================================
   Mobile Floating CTA Bar & Scroll Back to Top
   ========================================================================== */
.mobile-floating-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: rgba(11, 37, 69, 0.95);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-top: 1px solid var(--border-cyan);
  padding: 10px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  z-index: 990;
  box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.25);
}

@media (min-width: 768px) {
  .mobile-floating-bar {
    display: none;
  }
}

.mobile-floating-btn {
  flex: 1;
  padding: 10px 12px;
  font-size: 0.84rem;
  font-weight: 700;
  border-radius: 3px;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  text-decoration: none;
}

.mobile-floating-btn.primary {
  background: var(--cyan);
  color: var(--navy);
}

.mobile-floating-btn.secondary {
  background: rgba(255, 255, 255, 0.1);
  color: #FFFFFF;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.back-to-top {
  position: fixed;
  bottom: 30px;
  right: 24px;
  width: 44px;
  height: 44px;
  border-radius: 4px;
  background: var(--navy);
  color: var(--cyan);
  border: 1px solid var(--border-cyan);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: all var(--transition-normal);
  z-index: 900;
  box-shadow: var(--shadow-md);
}

.back-to-top.is-visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.back-to-top:hover,
.back-to-top:focus-visible {
  background: var(--cyan);
  color: var(--navy);
  box-shadow: var(--shadow-glow);
}

@media (max-width: 767px) {
  .back-to-top {
    bottom: 74px;
  }
}

.reveal-on-scroll {
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
}

.reveal-on-scroll.is-revealed {
  opacity: 1;
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  .reveal-on-scroll {
    opacity: 1 !important;
    transform: none !important;
  }
}

/* ==========================================================================
   Additions: Numbers Strip (Verified Metrics)
   ========================================================================== */
.numbers-strip-section {
  background: linear-gradient(180deg, var(--navy-dark) 0%, var(--navy) 100%);
  border-top: 1px solid var(--border-cyan);
  border-bottom: 1px solid var(--border-cyan);
  padding: 48px 0;
  position: relative;
}

.numbers-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 24px;
}

.number-stat-card {
  background: rgba(11, 37, 69, 0.7);
  border: 1px solid var(--border-dark);
  padding: 24px 20px;
  position: relative;
  border-radius: 4px;
  transition: transform var(--transition-normal), border-color var(--transition-normal);
}

.number-stat-card:hover {
  transform: translateY(-4px);
  border-color: var(--cyan);
}

.number-stat-val {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 3.5vw, 2.75rem);
  font-weight: 700;
  color: var(--cyan-bright);
  line-height: 1.1;
  margin-bottom: 8px;
}

.number-stat-lbl {
  font-size: 0.9rem;
  color: #FFFFFF;
  font-weight: 600;
  margin-bottom: 6px;
}

.number-stat-sub {
  font-size: 0.78rem;
  color: #B2C4D6;
  line-height: 1.4;
}

/* ==========================================================================
   Additions: Certifications & Trained Engineer Badges
   ========================================================================== */
.cert-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
  margin-top: 28px;
}

.cert-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  position: relative;
  transition: all var(--transition-normal);
}

.cert-card:hover {
  transform: translateY(-3px);
  border-color: var(--cyan);
  box-shadow: var(--shadow-md);
}

.cert-badge-tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  color: var(--cyan-deep);
  background: var(--cyan-subtle);
  padding: 3px 8px;
  border-radius: 2px;
  width: fit-content;
}

.cert-title {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  color: var(--navy);
  margin: 0;
}

.cert-desc {
  font-size: 0.86rem;
  color: var(--slate);
  line-height: 1.5;
  margin: 0;
}

/* ==========================================================================
   Additions: Interactive FAQ Accordion
   ========================================================================== */
.faq-accordion {
  max-width: 860px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.faq-item {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  overflow: hidden;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.faq-item.active {
  border-color: var(--cyan);
  box-shadow: var(--shadow-sm);
}

.faq-trigger {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 24px;
  background: transparent;
  border: none;
  cursor: pointer;
  text-align: left;
  font-family: var(--font-heading);
  font-size: 1.08rem;
  font-weight: 600;
  color: var(--navy);
  transition: color var(--transition-fast);
}

.faq-trigger:hover {
  color: var(--cyan-deep);
}

.faq-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  margin-left: 16px;
  transition: transform var(--transition-normal);
  color: var(--cyan-deep);
}

.faq-item.active .faq-icon {
  transform: rotate(180deg);
}

.faq-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1), padding 0.35s ease;
  padding: 0 24px;
}

.faq-item.active .faq-content {
  max-height: 400px;
  padding-bottom: 24px;
}

.faq-content p {
  font-size: 0.94rem;
  line-height: 1.7;
  color: var(--slate);
  margin: 0;
}

/* ==========================================================================
   Additions: Resources & Downloadables
   ========================================================================== */
.resource-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 28px;
  margin-top: 36px;
}

.resource-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 6px;
  padding: 32px 28px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-normal);
}

.resource-card:hover {
  transform: translateY(-4px);
  border-color: var(--cyan);
  box-shadow: var(--shadow-md);
}

.resource-doc-icon {
  width: 48px;
  height: 48px;
  background: var(--cyan-subtle);
  border: 1px solid rgba(24, 197, 224, 0.3);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cyan-deep);
  margin-bottom: 20px;
}

/* ==========================================================================
   Additions: Insights / Blog Hub Cards
   ========================================================================== */
.insights-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 28px;
  margin-top: 36px;
}

.insight-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 6px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: all var(--transition-normal);
  box-shadow: var(--shadow-sm);
}

.insight-card:hover {
  transform: translateY(-4px);
  border-color: var(--cyan);
  box-shadow: var(--shadow-md);
}

.insight-card-header {
  height: 180px;
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-dark) 100%);
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.insight-card-body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
  justify-content: space-between;
}

.insight-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-mono);
  font-size: 0.76rem;
  color: var(--slate);
  margin-bottom: 12px;
}

/* ==========================================================================
   Additions: Floating WhatsApp & Direct Quick Channels
   ========================================================================== */
.floating-whatsapp-widget {
  position: fixed;
  bottom: 30px;
  right: 90px;
  z-index: 998;
  display: flex;
  align-items: center;
  gap: 10px;
}

.whatsapp-bubble {
  width: 52px;
  height: 52px;
  background: #25D366;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  box-shadow: 0 4px 16px rgba(37, 211, 102, 0.4);
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  cursor: pointer;
  text-decoration: none;
}

.whatsapp-bubble:hover {
  transform: scale(1.08);
  box-shadow: 0 6px 20px rgba(37, 211, 102, 0.55);
}

.whatsapp-tooltip {
  background: var(--navy);
  color: #FFFFFF;
  font-size: 0.82rem;
  font-weight: 500;
  padding: 6px 14px;
  border-radius: 20px;
  box-shadow: var(--shadow-md);
  border: 1px solid var(--border-dark);
  white-space: nowrap;
  pointer-events: none;
  opacity: 0;
  transform: translateX(8px);
  transition: all var(--transition-normal);
}

.floating-whatsapp-widget:hover .whatsapp-tooltip {
  opacity: 1;
  transform: translateX(0);
}

@media (max-width: 767px) {
  .floating-whatsapp-widget {
    bottom: 74px;
    right: 20px;
  }
  .whatsapp-tooltip {
    display: none;
  }
}

/* ==========================================================================
   Additions: Client Login / AMC Portal Modal
   ========================================================================== */
.portal-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(6, 21, 40, 0.85);
  backdrop-filter: blur(8px);
  z-index: 10000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.portal-modal-overlay.active {
  display: flex;
}

.portal-modal-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 6px;
  max-width: 480px;
  width: 100%;
  padding: 32px;
  position: relative;
  box-shadow: var(--shadow-lg);
  animation: modalSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

@keyframes modalSlideIn {
  from { opacity: 0; transform: translateY(20px) scale(0.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.portal-modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--slate);
  padding: 6px;
  border-radius: 4px;
  transition: color var(--transition-fast);
}

.portal-modal-close:hover {
  color: var(--navy);
}

/* ==========================================================================
   Additions: Pre-Launch Confirmation Drawer / Banner
   ========================================================================== */
.prelaunch-banner {
  background: rgba(11, 37, 69, 0.95);
  border-bottom: 2px solid var(--cyan);
  color: #FFFFFF;
  padding: 10px 0;
  font-size: 0.82rem;
  font-family: var(--font-mono);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.prelaunch-checklist-btn {
  background: var(--cyan);
  color: var(--navy);
  border: none;
  font-size: 0.76rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 2px;
  cursor: pointer;
  transition: opacity var(--transition-fast);
}

.prelaunch-checklist-btn:hover {
  opacity: 0.9;
}

/* ==========================================================================
   Additions: Verified Numbers Strip
   ========================================================================== */
.numbers-strip-section {
  background: linear-gradient(135deg, #061528 0%, #0B2545 100%);
  color: #FFFFFF;
  padding: 44px 0;
  border-top: 1px solid rgba(24, 197, 224, 0.25);
  border-bottom: 1px solid rgba(24, 197, 224, 0.25);
  position: relative;
  overflow: hidden;
}

.numbers-strip-section::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    linear-gradient(to right, rgba(24, 197, 224, 0.05) 1px, transparent 1px),
    linear-gradient(to bottom, rgba(24, 197, 224, 0.05) 1px, transparent 1px);
  background-size: 32px 32px;
  pointer-events: none;
}

.numbers-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
  position: relative;
  z-index: 1;
}

@media (min-width: 992px) {
  .numbers-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
}

.number-stat-card {
  text-align: center;
  padding: 18px 16px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(24, 197, 224, 0.15);
  border-radius: 4px;
  transition: transform var(--transition-normal), border-color var(--transition-normal);
}

.number-stat-card:hover {
  transform: translateY(-4px);
  border-color: var(--cyan);
  background: rgba(24, 197, 224, 0.06);
}

.number-val {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 3.8vw, 3rem);
  font-weight: 800;
  color: var(--cyan-bright);
  line-height: 1.1;
  margin-bottom: 6px;
  display: block;
}

.number-lbl {
  font-family: var(--font-body);
  font-size: 0.92rem;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 6px;
}

.number-desc {
  font-size: 0.78rem;
  color: #8E9FAA;
  line-height: 1.4;
  margin: 0;
}

/* ==========================================================================
   Additions: Certifications & Partner Badges
   ========================================================================== */
.cert-grid {
  display: grid;
  grid-template-columns: repeat(1, 1fr);
  gap: 20px;
}

@media (min-width: 640px) {
  .cert-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .cert-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.cert-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
  position: relative;
}

.cert-card:hover {
  transform: translateY(-3px);
  border-color: var(--cyan-deep);
  box-shadow: var(--shadow-md);
}

.cert-icon-wrap {
  width: 48px;
  height: 48px;
  border-radius: 4px;
  background: rgba(24, 197, 224, 0.1);
  color: var(--navy);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}

.cert-title {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 6px;
}

.cert-meta {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--cyan-deep);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 10px;
}

.cert-desc {
  font-size: 0.85rem;
  color: var(--slate);
  line-height: 1.5;
  margin-bottom: 12px;
  flex-grow: 1;
}

.cert-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
}

.cert-badge-tag {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  background: #F1F5F9;
  color: var(--navy);
  padding: 2px 8px;
  border-radius: 2px;
  border: 1px solid #E2E8F0;
}

/* ==========================================================================
   Additions: Results-Led Client Case Studies
   ========================================================================== */
.case-studies-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
}

@media (min-width: 992px) {
  .case-studies-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.case-study-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-normal), box-shadow var(--transition-normal);
}

.case-study-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-lg);
  border-color: var(--cyan);
}

.case-study-header {
  padding: 20px 24px;
  background: #F8FAFC;
  border-bottom: 1px solid var(--border-light);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.case-study-client {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--navy);
}

.case-study-sector {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  padding: 3px 8px;
  background: rgba(11, 37, 69, 0.08);
  color: var(--navy);
  border-radius: 2px;
  font-weight: 600;
}

.case-study-body {
  padding: 24px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.case-study-challenge {
  font-size: 0.88rem;
  color: var(--slate);
  margin-bottom: 16px;
  line-height: 1.5;
}

.case-study-metric-box {
  background: #061528;
  color: #FFFFFF;
  border-left: 3px solid var(--cyan);
  padding: 14px 16px;
  border-radius: 2px;
  margin-bottom: 18px;
}

.case-metric-val {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--cyan-bright);
  display: block;
  line-height: 1.1;
  margin-bottom: 4px;
}

.case-metric-label {
  font-size: 0.78rem;
  color: #B2C4D6;
  line-height: 1.35;
}

.case-study-deliverables {
  list-style: none;
  padding: 0;
  margin: 0 0 20px 0;
  font-size: 0.82rem;
  color: var(--navy);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.case-study-deliverables li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.case-study-deliverables li svg {
  flex-shrink: 0;
  color: var(--cyan-deep);
  margin-top: 2px;
}

/* ==========================================================================
   Additions: Interactive FAQ Accordion
   ========================================================================== */
.faq-accordion {
  max-width: 860px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.faq-item {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  overflow: hidden;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.faq-item.active {
  border-color: var(--cyan-deep);
  box-shadow: var(--shadow-sm);
}

.faq-question-btn {
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  padding: 20px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  cursor: pointer;
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--navy);
  transition: color var(--transition-fast);
}

.faq-question-btn:hover {
  color: var(--cyan-deep);
}

.faq-icon-chevron {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--slate);
  transition: transform var(--transition-normal);
}

.faq-item.active .faq-icon-chevron {
  transform: rotate(180deg);
  color: var(--cyan-deep);
}

.faq-answer-panel {
  padding: 0 24px 20px;
  font-size: 0.92rem;
  color: var(--slate);
  line-height: 1.6;
  display: none;
  border-top: 1px solid #F1F5F9;
  padding-top: 16px;
}

.faq-item.active .faq-answer-panel {
  display: block;
}

/* ==========================================================================
   Additions: Downloadable Resources Grid
   ========================================================================== */
.resource-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}

@media (min-width: 768px) {
  .resource-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.resource-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  padding: 30px;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform var(--transition-normal), box-shadow var(--transition-normal), border-color var(--transition-normal);
}

.resource-card:hover {
  transform: translateY(-4px);
  border-color: var(--cyan-deep);
  box-shadow: var(--shadow-md);
}

.resource-card-type {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--cyan-deep);
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 0.08em;
  margin-bottom: 8px;
}

.resource-card-title {
  font-family: var(--font-heading);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 10px;
}

.resource-card-desc {
  font-size: 0.9rem;
  color: var(--slate);
  line-height: 1.55;
  margin-bottom: 24px;
  flex-grow: 1;
}

/* ==========================================================================
   Additions: Industry Vertical Pages & Cards
   ========================================================================== */
.industry-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}

@media (min-width: 640px) {
  .industry-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .industry-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.industry-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-normal), box-shadow var(--transition-normal);
}

.industry-card:hover {
  transform: translateY(-4px);
  border-color: var(--cyan-deep);
  box-shadow: var(--shadow-md);
}

.industry-card-img {
  height: 150px;
  width: 100%;
  object-fit: cover;
  background: var(--navy);
}

.industry-card-content {
  padding: 22px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.industry-card-title {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 8px;
}

.industry-card-desc {
  font-size: 0.86rem;
  color: var(--slate);
  line-height: 1.5;
  margin-bottom: 18px;
  flex-grow: 1;
}

/* ==========================================================================
   Additions: Insights Blog Grid
   ========================================================================== */
.insights-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 28px;
}

@media (min-width: 768px) {
  .insights-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .insights-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.insight-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 4px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-normal), box-shadow var(--transition-normal);
}

.insight-card:hover {
  transform: translateY(-4px);
  border-color: var(--cyan);
  box-shadow: var(--shadow-md);
}

.insight-card-header {
  height: 140px;
  background: linear-gradient(135deg, #061528, #0B2545);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  position: relative;
}

.insight-card-content {
  padding: 22px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.insight-category {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--cyan-deep);
  text-transform: uppercase;
  margin-bottom: 8px;
}

.insight-title {
  font-family: var(--font-heading);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--navy);
  line-height: 1.35;
  margin-bottom: 10px;
}

.insight-excerpt {
  font-size: 0.84rem;
  color: var(--slate);
  line-height: 1.5;
  margin-bottom: 18px;
  flex-grow: 1;
}

.insight-meta {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: #8E9FAA;
  display: flex;
  justify-content: space-between;
  border-top: 1px solid #F1F5F9;
  padding-top: 12px;
}

/* ==========================================================================
   Additions: Pre-Launch Checklist Modal
   ========================================================================== */
.checklist-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(6, 21, 40, 0.85);
  backdrop-filter: blur(8px);
  z-index: 10001;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.checklist-modal-overlay.active {
  display: flex;
}

.checklist-modal-card {
  background: #FFFFFF;
  border: 1px solid var(--border-light);
  border-radius: 6px;
  max-width: 680px;
  width: 100%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 32px;
  position: relative;
  box-shadow: var(--shadow-lg);
  animation: modalSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.checklist-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.86rem;
  margin: 16px 0;
}

.checklist-table th,
.checklist-table td {
  padding: 10px 12px;
  border-bottom: 1px solid #E2E8F0;
  text-align: left;
}

.checklist-table th {
  background: #F8FAFC;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  text-transform: uppercase;
  color: var(--navy);
}


